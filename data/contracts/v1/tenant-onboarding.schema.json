{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hobbiest.github.io/ExamGuru-Quest/data/contracts/v1/tenant-onboarding.schema.json",
  "title": "ExamGuru Tenant Onboarding Request v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "institutionType", "institutionName", "requestedSlug", "countryCode", "timezone", "status", "version", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tenant-onboarding-request" },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "institutionType": { "enum": ["school", "college", "coaching_centre", "competitive_exam_provider", "direct", "other"] },
    "institutionName": { "type": "string", "minLength": 2, "maxLength": 160 },
    "requestedSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "requestedByUserId": { "type": ["string", "null"], "maxLength": 80 },
    "primaryAdminEmail": { "type": ["string", "null"], "format": "email", "maxLength": 254 },
    "requestedPlanId": { "type": ["string", "null"], "maxLength": 80 },
    "status": { "enum": ["requested", "under_review", "approved", "provisioned", "active", "rejected", "suspended", "cancelled"] },
    "tenantId": { "type": ["string", "null"], "minLength": 8, "maxLength": 80 },
    "reviewedBy": { "type": ["string", "null"], "maxLength": 80 },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "decisionReason": { "type": ["string", "null"], "maxLength": 1000 },
    "version": { "type": "integer", "minimum": 1 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 160 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["provisioned", "active"] } }, "required": ["status"] },
      "then": { "required": ["tenantId"], "properties": { "tenantId": { "type": "string" } } } },
    { "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
      "then": { "required": ["decisionReason"], "properties": { "decisionReason": { "type": "string", "minLength": 1 } } } }
  ],
  "additionalProperties": false
}