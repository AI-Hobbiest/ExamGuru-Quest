{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamGuru Institution Content Import",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "institutionId",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "institution-mcq-bank",
        "institution-test-paper"
      ]
    },
    "institutionId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}