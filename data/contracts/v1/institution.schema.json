{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hobbiest.github.io/ExamGuru-Quest/data/contracts/v1/institution.schema.json",
  "title": "ExamGuru Institution v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "institutionId",
    "name",
    "slug",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "institution"
    },
    "institutionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "closed"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "institutionType": {
      "type": "string",
      "enum": [
        "school",
        "college",
        "coaching_centre",
        "competitive_exam_provider",
        "direct",
        "other"
      ]
    },
    "entitlements": {
      "type": "object",
      "required": [
        "curriculum",
        "competitiveExams"
      ],
      "properties": {
        "curriculum": {
          "type": "object",
          "required": [
            "enabled",
            "classIds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "classIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "competitiveExams": {
          "type": "object",
          "required": [
            "enabled",
            "examIds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "examIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}